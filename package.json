{
  "name": "mx-template-dapp-vue",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-devnet": "pnpm copy-devnet-config && pnpm build",
    "build-testnet": "pnpm copy-testnet-config && pnpm build",
    "build-mainnet": "pnpm copy-mainnet-config && pnpm build",
    "copy-devnet-config": "cp ./src/config/config.devnet.ts ./src/config/index.ts",
    "copy-testnet-config": "cp ./src/config/config.testnet.ts ./src/config/index.ts",
    "copy-mainnet-config": "cp ./src/config/config.mainnet.ts ./src/config/index.ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "start-devnet": "pnpm copy-devnet-config && vite",
    "start-testnet": "pnpm copy-testnet-config && vite",
    "start-mainnet": "pnpm copy-mainnet-config && vite",
    "type-check": "vue-tsc --build",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.0",
    "@multiversx/sdk-core": "^15.4.1",
    "@multiversx/sdk-dapp": "^5.7.2",
    "@multiversx/sdk-dapp-ui": "^0.1.26",
    "bignumber.js": "^9.3.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
